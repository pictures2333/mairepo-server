# Database
DATABASE_URL=postgresql+asyncpg://mairepo:change_me@db:5432/mairepo

# Google Drive source
MAISQUARED_FOLDER_ID=replace_with_google_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_CRED_FILE=/run/secrets/google_service_account
SYNC_CONCURRENCY=8
RUN_SYNC_INTERVAL=3600

# Blob storage and retention
DIRECTORY=/var/lib/mairepo/storage
GC_KEEP=3
GC_MAX_KEEP=7
RUN_GC_INTERVAL=43200
RUN_CHECK_INTERVAL=86400

# API authentication; leave empty to allow unauthenticated requests
TOKEN=replace_with_a_random_secret

# Retry policy
MAX_ATTEMPTS=3
